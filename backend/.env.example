# Add your Anthropic API key to enable rejected-row repair. Missing key skips LLM repair.
ANTHROPIC_API_KEY=
# Leave blank to use the default of 1000 rows per batch.
BATCH_SIZE=
# Leave blank to use the existing root CSV. Relative paths start at backend/.
CSV_FILE_PATH=
# Separate from CSV BATCH_SIZE; defaults to 5. Output budget may reduce effective size.
LLM_BATCH_SIZE=
# Defaults to claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=
